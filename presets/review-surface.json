  "voice": {
    "tone": "Precise and quietly confident. Never salesy. Speaks like an architect reviewing blueprints with colleagues — direct, grounded, respectful of the reader's time.",
    "attributes": [
      { "trait": "transparent", "description": "Always show the reasoning behind claims. Never hide assumptions or present guesses as facts." },
      { "trait": "precise", "description": "Use specific evidence over vague statements. Name the API, quote the doc, cite the source." },
      { "trait": "grounded", "description": "Every claim traces to a source tier — confirmed, internal, or assumption. No floating assertions." },
      { "trait": "direct", "description": "One sentence where one works. No preamble, no hedging that adds no information." },
      { "trait": "peer-level", "description": "The reader is a colleague, not an audience. Speak as an architect to architects." }
    ],
    "principles": [
      "Show the reasoning, not just the conclusion",
      "Distinguish what we know from what we assume",
      "Let the evidence speak — don't oversell",
      "Be direct — one sentence where one sentence works",
      "The reader is a peer, not an audience"
    ],
    "avoid": [
      "Marketing language (leverage, synergy, unlock)",
      "Hedging that adds no information",
      "Exclamation points",
      "Emoji in professional context",
      "Anthropomorphizing the AI"
    ]
  },

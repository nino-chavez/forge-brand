    "creative": {
      "basePrompt": "BRAND: Flickday Media — grassroots sports media company specializing in volleyball and action sports content. Chicago-based.\nAESTHETIC: Sports press credential meets high-energy action photography. Think press badges, media passes, contact sheets, shutter speed displays, and field-side energy.\n\nKEY VISUAL LANGUAGE:\n- Camera aperture blades (6-blade iris) — the core brand motif\n- Volleyball panel lines merged with aperture geometry\n- Motion trails, speed lines, kinetic energy\n- Press credential badges, lanyards, media passes\n- Film strip frames, contact sheet grids\n- Shutter speed / ISO / f-stop readouts as decorative type\n- High contrast: yellow on black, or black on yellow\n- Clean geometric shapes, no ornamental flourishes",
      "conceptMap": {
        "aperture": "camera aperture iris blades, 6-blade pattern, the core brand icon",
        "shutter": "shutter mechanism, curtain reveal, decisive moment",
        "volleyball": "volleyball with visible panel lines, slightly stylized, clean",
        "motion": "speed lines, motion blur trails, kinetic energy, movement",
        "credential": "press badge, media pass, VIP credential, accreditation",
        "viewfinder": "camera viewfinder overlay, focus brackets, exposure readout",
        "grain": "film grain texture, high-ISO noise, analog warmth",
        "photos": "photography badge, yellow accent, static captures",
        "video": "video badge, orange accent, motion content",
        "reels": "reels badge, pink accent, short-form edits"
      },
      "formatModifiers": {
        "dtf-front": "Vertical composition for center chest print. 2400x3000px (8x10 at 300dpi). Yellow and white on transparent.",
        "dtf-back": "Tall vertical composition for full back print. 3000x3600px (10x12 at 300dpi). More detail permitted.",
        "dtf-pocket": "Small square for left chest. 1200x1200px (4x4 at 300dpi). Simplified, icon-like.",
        "web": "Standard web resolution. 1200x675px. Landscape format.",
        "print": "High-res output. 300dpi minimum."
      },
      "visualKeywords": ["aperture", "volleyball", "motion", "speed", "press-credential", "film-grain", "high-contrast", "geometric"],
      "avoid": ["text in AI-generated images", "ornamental flourishes", "gradients without purpose", "stock photo aesthetics", "corporate polish"]
    },

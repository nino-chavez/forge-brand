  "voice": {
    "attributes": [
      { "trait": "authentic", "description": "Real grassroots energy, not polished corporate", "example": "We're courtside, not in the boardroom." },
      { "trait": "energetic", "description": "High-energy, action-forward language", "example": "Every rally, every dive, every point — we're there." },
      { "trait": "player-focused", "description": "Always centers the athlete, not the brand", "example": "Your game. Your moment. We just capture it." },
      { "trait": "direct", "description": "Short sentences, no filler, no jargon", "example": "Book us. Show up. Get your shots." }
    ],
    "antiPatterns": [
      {
        "category": "corporate-jargon",
        "patterns": ["leverage", "synergy", "holistic", "paradigm", "ecosystem", "circle back", "deep dive", "unpack"],
        "severity": "error",
        "suggestion": "Use plain language. Say what you mean."
      },
      {
        "category": "passive-voice",
        "patterns": ["was captured", "has been provided", "will be delivered"],
        "severity": "warning",
        "suggestion": "Use active voice. The photographer shoots. The player spikes."
      },
      {
        "category": "generic-hype",
        "patterns": ["world-class", "best-in-class", "cutting-edge", "next-level", "game-changing"],
        "severity": "warning",
        "suggestion": "Show, don't tell. Describe the specific thing instead of using superlatives."
      }
    ],
    "structuralPatterns": [
      { "name": "short-punchy", "description": "Keep sentences under 15 words where possible", "required": false },
      { "name": "action-verbs", "description": "Lead with verbs: Shoot. Capture. Deliver.", "required": false }
    ],
    "examples": [
      {
        "intent": "Describe the service",
        "good": "We shoot grassroots volleyball. Tournaments, open gyms, beach sessions. Raw action, fast turnaround.",
        "bad": "Flickday Media provides comprehensive sports media solutions leveraging our extensive experience in the volleyball ecosystem."
      },
      {
        "intent": "Call to action",
        "good": "Book us for your next tournament.",
        "bad": "Don't hesitate to reach out to discuss how we can elevate your event's media presence."
      }
    ],
    "minimumScore": 70
  },
